<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu_bubble"
    android:padding="16dp">

    <TextView
        android:id="@+id/menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:text="应用操作" />

    <Button
        android:id="@+id/btn_action_move"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_menu_item"
        android:textColor="@color/menu_item_text_color"
        android:textSize="15sp"
        android:text="↔  移动位置"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_action_remove"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_menu_item"
        android:textColor="@color/menu_item_text_color"
        android:textSize="15sp"
        android:text="✕  从桌面移除"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_action_replace"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_menu_item"
        android:textColor="@color/menu_item_text_color"
        android:textSize="15sp"
        android:text="🔄  替换应用"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_action_uninstall"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_menu_item"
        android:textColor="@color/menu_danger_text_color"
        android:textSize="15sp"
        android:text="🗑  卸载应用"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</LinearLayout>
